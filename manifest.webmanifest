{
  "name": "Recipe Box",
  "short_name": "Recipe Box",
  "description": "Your recipes and a grocery list that knows what you already have.",
  "start_url": "./#/recipes",
  "scope": "./",
  "display": "standalone",
  "background_color": "#7a8aba",
